    "def kinetic_proofreading_monte_carlo(expression, num_samples, alpha, k, equilibrium=True):\n",
    "\n",
    "    datapoints = []\n",
    "    for i in range(num_samples):\n",
    "        new_edge_to_weight = gen.gen_core_butterfly_dict(alpha, k, equilibrium=equilibrium)\n",
    "        terminal = 10**((6* np.random.rand()) - 3)\n",
    "        new_edge_to_weight[(f'p_{k}', 'e')] = terminal\n",
    "        new_edge_to_weight[(f'p_bar_{k}', 'e_bar')] = terminal\n",
    "\n",
    "        new_sym_to_weight = butterfly_t.make_sym_to_weight(new_edge_to_weight)\n",
    "        new_datapoint = expression.subs(new_sym_to_weight)\n",
    "        datapoints.append(new_datapoint)\n",
    "\n",
    "    return datapoints\n",
    "\n",
    "expression = epsilon_sp\n",
    "num_samples = 1\n",
    "alpha = 5\n",
    "\n",
    "eq_datapoints = kinetic_proofreading_monte_carlo(expression, num_samples, alpha, k)\n",
    "\n",
    "print(f'max: {max(eq_datapoints)}')\n",
    "print(f'min: {min(eq_datapoints)}')"
   ]
  },
